+static cbm_store_t *setup_property_compare_store(void) {
+    cbm_store_t *s = cbm_store_open_memory();
+    cbm_store_upsert_project(s, "prop", "/tmp/prop");
+
+    cbm_node_t n1 = {.project = "prop",
+                     .label = "Function",
+                     .name = "Caller",
+                     .qualified_name = "prop.Caller",
+                     .file_path = "same.go",
+                     .start_line = 20,
+                     .end_line = 30};
+    cbm_node_t n2 = {.project = "prop",
+                     .label = "Function",
+                     .name = "SameFileCallee",
+                     .qualified_name = "prop.SameFileCallee",
+                     .file_path = "same.go",
+                     .start_line = 10,
+                     .end_line = 15};
+    cbm_node_t n3 = {.project = "prop",
+                     .label = "Function",
+                     .name = "OtherFileCallee",
+                     .qualified_name = "prop.OtherFileCallee",
+                     .file_path = "other.go",
+                     .start_line = 40,
+                     .end_line = 50};
+
+    int64_t id1 = cbm_store_upsert_node(s, &n1);
+    int64_t id2 = cbm_store_upsert_node(s, &n2);
+    int64_t id3 = cbm_store_upsert_node(s, &n3);
+
+    cbm_edge_t e1 = {.project = "prop", .source_id = id1, .target_id = id2, .type = "CALLS"};
+    cbm_edge_t e2 = {.project = "prop", .source_id = id1, .target_id = id3, .type = "CALLS"};
+    cbm_edge_t e3 = {.project = "prop", .source_id = id2, .target_id = id3, .type = "CALLS"};
+    cbm_store_insert_edge(s, &e1);
+    cbm_store_insert_edge(s, &e2);
+    cbm_store_insert_edge(s, &e3);
+
+    return s;
+}
