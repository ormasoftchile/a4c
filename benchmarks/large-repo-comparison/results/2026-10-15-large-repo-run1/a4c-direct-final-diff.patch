+TEST(cypher_exec_where_property_equals_property) {
+    cbm_store_t *s = setup_property_compare_store();
+    cbm_cypher_result_t r = {0};
+
+    int rc = cbm_cypher_execute(s,
+                                "MATCH (f:Function)-[:CALLS]->(g:Function) "
+                                "WHERE f.file_path = g.file_path "
+                                "RETURN f.name, g.name",
+                                "prop", 0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r.row_count, 1);
+    ASSERT_STR_EQ(r.rows[0][0], "Caller");
+    ASSERT_STR_EQ(r.rows[0][1], "SameFileCallee");
+
+    cbm_cypher_result_free(&r);
+    cbm_store_close(s);
+    PASS();
+}
+
+TEST(cypher_exec_where_property_not_equals_property) {
