+static bool pattern_defines_variable(const cbm_query_t *q, const char *variable) {
+    if (q->unwind_alias && strcmp(q->unwind_alias, variable) == 0) {
+        return true;
+    }
+    for (int pi = 0; pi < q->pattern_count; pi++) {
+        const cbm_pattern_t *pat = &q->patterns[pi];
+        for (int ni = 0; ni < pat->node_count; ni++) {
+            if (pat->nodes[ni].variable && strcmp(pat->nodes[ni].variable, variable) == 0) {
+                return true;
+            }
+        }
+        for (int ri = 0; ri < pat->rel_count; ri++) {
+            if (pat->rels[ri].variable && strcmp(pat->rels[ri].variable, variable) == 0) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+static bool with_clause_defines_variable(const cbm_return_clause_t *with, const char *variable) {
+    if (!with) {
+        return false;
+    }
+    for (int i = 0; i < with->count; i++) {
+        const cbm_return_item_t *item = &with->items[i];
+        if (item->alias && strcmp(item->alias, variable) == 0) {
+            return true;
+        }
+        if (!item->alias && !item->func && !item->kase && !item->property && item->variable &&
+            strcmp(item->variable, variable) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
