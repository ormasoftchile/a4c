+static bool validate_rhs_expr(parser_t *p, const cbm_expr_t *expr, const cbm_query_t *q,
+                              bool after_with) {
+    if (!expr) {
+        return true;
+    }
+    if (expr->type == EXPR_CONDITION && expr->cond.rhs_variable) {
+        bool defined = after_with ? with_clause_defines_variable(q->with_clause,
+                                                                  expr->cond.rhs_variable)
+                                  : pattern_defines_variable(q, expr->cond.rhs_variable);
+        if (!defined) {
+            snprintf(p->error, sizeof(p->error), "unbound RHS variable '%s' in WHERE clause",
+                     expr->cond.rhs_variable);
+            return false;
+        }
+    }
+    return validate_rhs_expr(p, expr->left, q, after_with) &&
+           validate_rhs_expr(p, expr->right, q, after_with);
+}
+
+static bool validate_where_rhs(parser_t *p, const cbm_where_clause_t *where, const cbm_query_t *q,
+                               bool after_with) {
+    if (!where) {
+        return true;
+    }
+    if (where->root) {
+        return validate_rhs_expr(p, where->root, q, after_with);
+    }
+    for (int i = 0; i < where->count; i++) {
+        if (where->conditions[i].rhs_variable) {
+            bool defined = after_with
+                               ? with_clause_defines_variable(q->with_clause,
+                                                              where->conditions[i].rhs_variable)
+                               : pattern_defines_variable(q, where->conditions[i].rhs_variable);
+            if (!defined) {
+                snprintf(p->error, sizeof(p->error), "unbound RHS variable '%s' in WHERE clause",
+                         where->conditions[i].rhs_variable);
+                return false;
+            }
+        }
+    }
+    return true;
+}
