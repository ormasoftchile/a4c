+    ASSERT_STR_EQ(r.rows[0][0], "Alpha");
+    ASSERT_STR_EQ(r.rows[0][1], "Alpha");
+    ASSERT_STR_EQ(r.rows[1][0], "Alpha");
+    ASSERT_STR_EQ(r.rows[1][1], "Beta");
