+static cbm_store_t *setup_cypher_prop_compare_store(void) {
+    cbm_store_t *s = cbm_store_open_memory();
+    cbm_store_upsert_project(s, "test", "/tmp/test");
+
+    cbm_node_t n1 = {.project = "test",
+                     .label = "Function",
+                     .name = "Alpha",
+                     .qualified_name = "test.Alpha",
+                     .file_path = "shared.go",
+                     .start_line = 20};
+    cbm_node_t n2 = {.project = "test",
+                     .label = "Function",
+                     .name = "Beta",
+                     .qualified_name = "test.Beta",
+                     .file_path = "shared.go",
+                     .start_line = 10};
+    cbm_node_t n3 = {.project = "test",
+                     .label = "Function",
+                     .name = "Gamma",
+                     .qualified_name = "test.Gamma",
+                     .file_path = "other.go",
+                     .start_line = 30};
+    cbm_node_t n4 = {.project = "test",
+                     .label = "Function",
+                     .name = "Delta",
+                     .qualified_name = "test.Delta",
+                     .file_path = "delta.go",
+                     .start_line = 5};
+
+    int64_t id1 = cbm_store_upsert_node(s, &n1);
+    int64_t id2 = cbm_store_upsert_node(s, &n2);
+    int64_t id3 = cbm_store_upsert_node(s, &n3);
+    int64_t id4 = cbm_store_upsert_node(s, &n4);
+
+    cbm_edge_t e1 = {.project = "test", .source_id = id1, .target_id = id2, .type = "CALLS"};
+    cbm_edge_t e2 = {.project = "test", .source_id = id1, .target_id = id3, .type = "CALLS"};
+    cbm_edge_t e3 = {.project = "test", .source_id = id2, .target_id = id4, .type = "CALLS"};
+    cbm_edge_t e4 = {.project = "test", .source_id = id1, .target_id = id1, .type = "CALLS"};
+    cbm_store_insert_edge(s, &e1);
+    cbm_store_insert_edge(s, &e2);
+    cbm_store_insert_edge(s, &e3);
+    cbm_store_insert_edge(s, &e4);
+
+    return s;
+}
