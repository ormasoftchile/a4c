diff --git a/tests/test_cypher.c b/tests/test_cypher.c
index 2e79c8b..e811355 100644
--- a/tests/test_cypher.c
+++ b/tests/test_cypher.c
@@ -306,6 +306,36 @@ TEST(cypher_parse_where_clause) {
     PASS();
 }
 
+TEST(cypher_parse_where_property_rhs) {
+    cbm_query_t *q = NULL;
+    char *err = NULL;
+    int rc =
+        cbm_cypher_parse("MATCH (a)-[:CALLS]->(b) WHERE a.file_path = b.file_path RETURN a.name",
+                         &q, &err);
+    ASSERT_EQ(rc, 0);
+    ASSERT_NULL(err);
+    ASSERT_NOT_NULL(q->where->root);
+    ASSERT_TRUE(q->where->root->cond.rhs_is_expr);
+    ASSERT_STR_EQ(q->where->root->cond.rhs_variable, "b");
+    ASSERT_STR_EQ(q->where->root->cond.rhs_property, "file_path");
+
+    cbm_query_free(q);
+    PASS();
+}
+
+TEST(cypher_parse_where_rhs_function_rejected) {
+    cbm_query_t *q = NULL;
+    char *err = NULL;
+    int rc = cbm_cypher_parse("MATCH (a)-[:CALLS]->(b) WHERE a.name = toString(b.name) RETURN a",
+                              &q, &err);
+    ASSERT_EQ(rc, -1);
+    ASSERT_NOT_NULL(err);
+    ASSERT_TRUE(strstr(err, "function calls are not supported") != NULL);
+
+    free(err);
+    PASS();
+}
