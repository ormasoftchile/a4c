 TEST(cypher_parse_where_regex) {
     cbm_query_t *q = NULL;
     char *err = NULL;
@@ -470,6 +500,29 @@ static cbm_store_t *setup_cypher_store(void) {
     return s;
 }
 
+static void add_same_file_call(cbm_store_t *s) {
+    cbm_node_t caller = {.project = "test",
+                         .label = "Function",
+                         .name = "SameFileCaller",
+                         .qualified_name = "test.SameFileCaller",
+                         .file_path = "same.go",
+                         .start_line = 1,
+                         .end_line = 4};
+    cbm_node_t callee = {.project = "test",
+                         .label = "Function",
+                         .name = "SameFileCallee",
+                         .qualified_name = "test.SameFileCallee",
+                         .file_path = "same.go",
+                         .start_line = 2,
+                         .end_line = 3};
+
+    int64_t caller_id = cbm_store_upsert_node(s, &caller);
+    int64_t callee_id = cbm_store_upsert_node(s, &callee);
+    cbm_edge_t call = {
+        .project = "test", .source_id = caller_id, .target_id = callee_id, .type = "CALLS"};
+    cbm_store_insert_edge(s, &call);
+}
+
