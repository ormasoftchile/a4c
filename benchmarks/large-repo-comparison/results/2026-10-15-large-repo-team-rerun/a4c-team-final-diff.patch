@@ -0,0 +1,15 @@
+package codebasememorymcp
+
+import (
+	"os/exec"
+	"testing"
+)
+
+func TestGoInstallerModule(t *testing.T) {
+	cmd := exec.Command("go", "test", "./...")
+	cmd.Dir = "pkg/go"
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("pkg/go tests failed: %v\n%s", err, out)
+	}
+}
