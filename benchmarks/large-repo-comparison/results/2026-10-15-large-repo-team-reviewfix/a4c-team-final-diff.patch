+TEST(cypher_exec_where_prop_rhs_eq) {
+    cbm_store_t *s = setup_cypher_store();
+    cbm_node_t n = {.project = "test",
+                    .label = "Function",
+                    .name = "HandleOrderPeer",
+                    .qualified_name = "test.HandleOrderPeer",
+                    .file_path = "handler.go"};
+    int64_t peer_id = cbm_store_upsert_node(s, &n);
+    cbm_node_t handle = {0};
+    ASSERT_EQ(cbm_store_find_node_by_qn(s, "test", "test.HandleOrder", &handle), CBM_STORE_OK);
+    cbm_edge_t e = {.project = "test", .source_id = peer_id, .target_id = handle.id, .type = "CALLS"};
+    cbm_store_insert_edge(s, &e);
+    cbm_node_free_fields(&handle);
+    cbm_cypher_result_t r = {0};
+
+    int rc = cbm_cypher_execute(s,
+                                "MATCH (a:Function)-[:CALLS]->(b:Function) "
+                                "WHERE a.file_path = b.file_path "
+                                "RETURN a.name, b.name",
+                                "test", 0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r.row_count, 1);
+
+    cbm_cypher_result_free(&r);
+    cbm_store_close(s);
+    PASS();
+}
+
+TEST(cypher_exec_where_prop_rhs_neq) {
+    cbm_store_t *s = setup_cypher_store();
+    cbm_cypher_result_t r = {0};
+
+    int rc = cbm_cypher_execute(s,
+                                "MATCH (a:Function) MATCH (b:Function) "
+                                "WHERE a.name <> b.name RETURN a.name, b.name",
+                                "test", 0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r.row_count, 12); /* 4x4 minus same-name pairs */
+
+    cbm_cypher_result_free(&r);
+    cbm_store_close(s);
+    PASS();
+}
+
+TEST(cypher_exec_where_prop_rhs_ordering) {
+    cbm_store_t *s = setup_cypher_store();
+    cbm_cypher_result_t r = {0};
+
+    int rc = cbm_cypher_execute(s,
