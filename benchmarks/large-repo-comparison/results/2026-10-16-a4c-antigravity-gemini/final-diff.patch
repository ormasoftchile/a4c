diff --git a/tests/test_cypher.c b/tests/test_cypher.c
index 2e79c8b..e7b9f49 100644
--- a/tests/test_cypher.c
+++ b/tests/test_cypher.c
@@ -2521,6 +2521,94 @@ TEST(cypher_multi_prop_projection_no_alias) {
     PASS();
 }
 
+/* Property-to-property WHERE comparisons (=, <>, ordering, and post-WITH). */
+TEST(cypher_where_prop_to_prop) {
+    cbm_store_t *s = setup_cypher_http_store();
+
+    /* 1. Equality: ValidateOrder and SubmitOrder are both in service.go;
+     * add a CALLS edge ValidateOrder -> SubmitOrder so we have a same-file edge
+     * and a cross-file edge HandleOrder (main.go) -> SubmitOrder (service.go). */
+    cbm_node_t *vo = NULL;
+    int vo_cnt = 0;
+    cbm_store_find_nodes_by_name(s, "test", "ValidateOrder", &vo, &vo_cnt);
+    cbm_node_t *so = NULL;
+    int so_cnt = 0;
+    cbm_store_find_nodes_by_name(s, "test", "SubmitOrder", &so, &so_cnt);
+    cbm_node_t *ho = NULL;
+    int ho_cnt = 0;
+    cbm_store_find_nodes_by_name(s, "test", "HandleOrder", &ho, &ho_cnt);
+    ASSERT_EQ(vo_cnt, 1);
+    ASSERT_EQ(so_cnt, 1);
+    ASSERT_EQ(ho_cnt, 1);
+
+    cbm_edge_t c1 = {
+        .project = "test", .source_id = ho[0].id, .target_id = vo[0].id, .type = "CALLS"};
+    cbm_edge_t c2 = {
+        .project = "test", .source_id = vo[0].id, .target_id = so[0].id, .type = "CALLS"};
+    cbm_store_insert_edge(s, &c1);
+    cbm_store_insert_edge(s, &c2);
+    cbm_store_free_nodes(vo, vo_cnt);
+    cbm_store_free_nodes(so, so_cnt);
+    cbm_store_free_nodes(ho, ho_cnt);
+
+    /* Same file_path (=): only ValidateOrder -> SubmitOrder (both in service.go) */
+    cbm_cypher_result_t r_eq = {0};
+    int rc = cbm_cypher_execute(s,
+                                "MATCH (a:Function)-[:CALLS]->(b:Function) "
+                                "WHERE a.file_path = b.file_path "
+                                "RETURN a.name, b.name",
+                                "test", 0, &r_eq);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r_eq.row_count, 1);
+    ASSERT_STR_EQ(r_eq.rows[0][0], "ValidateOrder");
+    ASSERT_STR_EQ(r_eq.rows[0][1], "SubmitOrder");
+    cbm_cypher_result_free(&r_eq);
+
+    /* Different file_path (<>): only HandleOrder (main.go) -> ValidateOrder (service.go) */
+    cbm_cypher_result_t r_neq = {0};
+    rc = cbm_cypher_execute(s,
+                            "MATCH (a:Function)-[:CALLS]->(b:Function) "
+                            "WHERE a.file_path <> b.file_path "
+                            "RETURN a.name, b.name",
+                            "test", 0, &r_neq);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r_neq.row_count, 1);
+    ASSERT_STR_EQ(r_neq.rows[0][0], "HandleOrder");
+    ASSERT_STR_EQ(r_neq.rows[0][1], "ValidateOrder");
+    cbm_cypher_result_free(&r_neq);
+
+    /* Ordering (<): a.start_line < b.start_line
+     * ValidateOrder (start_line 5) -> SubmitOrder (start_line 25) matches;
+     * HandleOrder (start_line 10) -> ValidateOrder (start_line 5) does not. */
+    cbm_cypher_result_t r_lt = {0};
+    rc = cbm_cypher_execute(s,
+                            "MATCH (a:Function)-[:CALLS]->(b:Function) "
+                            "WHERE a.start_line < b.start_line "
+                            "RETURN a.name, b.name",
+                            "test", 0, &r_lt);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r_lt.row_count, 1);
+    ASSERT_STR_EQ(r_lt.rows[0][0], "ValidateOrder");
+    ASSERT_STR_EQ(r_lt.rows[0][1], "SubmitOrder");
+    cbm_cypher_result_free(&r_lt);
+
+    /* Post-WITH node property comparison: WITH a, b WHERE a.file_path = b.file_path */
+    cbm_cypher_result_t r_with = {0};
+    rc = cbm_cypher_execute(s,
+                            "MATCH (a:Function)-[:CALLS]->(b:Function) "
+                            "WITH a, b WHERE a.file_path = b.file_path "
+                            "RETURN a.name, b.name",
+                            "test", 0, &r_with);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r_with.row_count, 1);
+    ASSERT_STR_EQ(r_with.rows[0][0], "ValidateOrder");
+    ASSERT_STR_EQ(r_with.rows[0][1], "SubmitOrder");
+    cbm_cypher_result_free(&r_with);
+
+    cbm_store_close(s);
+    PASS();
+}
