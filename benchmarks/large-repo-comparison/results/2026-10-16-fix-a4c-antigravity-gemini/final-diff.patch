+/* ── Property-to-property & bare-alias WHERE comparisons ───────── */
+
+TEST(cypher_parse_where_prop_to_prop) {
+    cbm_query_t *q = NULL;
+    char *err = NULL;
+    int rc = cbm_cypher_parse(
+        "MATCH (a)-[:CALLS]->(b) WHERE a.file_path = b.file_path RETURN a.name, b.name", &q, &err);
+    ASSERT_EQ(rc, 0);
+    ASSERT_NULL(err);
+    ASSERT_NOT_NULL(q);
+    ASSERT_NOT_NULL(q->where);
+    ASSERT_NOT_NULL(q->where->root);
+    ASSERT_EQ(q->where->root->type, EXPR_CONDITION);
+    ASSERT_STR_EQ(q->where->root->cond.variable, "a");
+    ASSERT_STR_EQ(q->where->root->cond.property, "file_path");
+    ASSERT_STR_EQ(q->where->root->cond.op, "=");
+    ASSERT_NULL(q->where->root->cond.value);
+    ASSERT_STR_EQ(q->where->root->cond.rhs_variable, "b");
+    ASSERT_STR_EQ(q->where->root->cond.rhs_property, "file_path");
+    cbm_query_free(q);
+
+    /* Bare alias on the RHS */
+    rc = cbm_cypher_parse(
+        "MATCH (a)-[:CALLS]->(b) WITH a.file_path AS af, b.file_path AS bf WHERE af = bf RETURN af",
+        &q, &err);
+    ASSERT_EQ(rc, 0);
+    ASSERT_NULL(err);
+    ASSERT_NOT_NULL(q);
+    ASSERT_NOT_NULL(q->post_with_where);
+    ASSERT_NOT_NULL(q->post_with_where->root);
+    ASSERT_STR_EQ(q->post_with_where->root->cond.variable, "af");
+    ASSERT_NULL(q->post_with_where->root->cond.property);
+    ASSERT_STR_EQ(q->post_with_where->root->cond.rhs_variable, "bf");
+    ASSERT_NULL(q->post_with_where->root->cond.rhs_property);
+    cbm_query_free(q);
+
+    /* Reject function calls on the RHS */
+    rc = cbm_cypher_parse("MATCH (a) WHERE a.name = foo(a.name) RETURN a.name", &q, &err);
+    ASSERT_EQ(rc, -1);
+    ASSERT_NOT_NULL(err);
+    free(err);
+    PASS();
+}
+
+TEST(cypher_exec_where_prop_eq) {
+    /* setup_cypher_http_store has ValidateOrder (service.go) and SubmitOrder (service.go)
+     * plus HandleOrder (main.go). Add CALLS edges so we have both same-file and cross-file calls. */
+    cbm_store_t *s = setup_cypher_http_store();
+    cbm_node_t n1 = {.project = "test",
+                     .label = "Function",
+                     .name = "HandleOrder",
+                     .qualified_name = "test.main.HandleOrder",
+                     .file_path = "main.go",
+                     .start_line = 10,
+                     .end_line = 30};
+    cbm_node_t n2 = {.project = "test",
+                     .label = "Function",
+                     .name = "ValidateOrder",
+                     .qualified_name = "test.service.ValidateOrder",
+                     .file_path = "service.go",
+                     .start_line = 5,
+                     .end_line = 20};
+    cbm_node_t n3 = {.project = "test",
+                     .label = "Function",
+                     .name = "SubmitOrder",
+                     .qualified_name = "test.service.SubmitOrder",
+                     .file_path = "service.go",
+                     .start_line = 25,
+                     .end_line = 50};
+    int64_t id1 = cbm_store_upsert_node(s, &n1);
+    int64_t id2 = cbm_store_upsert_node(s, &n2);
+    int64_t id3 = cbm_store_upsert_node(s, &n3);
+    cbm_edge_t e1 = {.project = "test", .source_id = id1, .target_id = id2, .type = "CALLS"};
+    cbm_edge_t e2 = {.project = "test", .source_id = id2, .target_id = id3, .type = "CALLS"};
+    cbm_store_insert_edge(s, &e1);
+    cbm_store_insert_edge(s, &e2);
+
+    cbm_cypher_result_t r = {0};
+    int rc = cbm_cypher_execute(
+        s, "MATCH (a:Function)-[:CALLS]->(b:Function) WHERE a.file_path = b.file_path RETURN a.name, b.name",
+        "test", 0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r.row_count, 1);
+    ASSERT_STR_EQ(r.rows[0][0], "ValidateOrder");
+    ASSERT_STR_EQ(r.rows[0][1], "SubmitOrder");
+    cbm_cypher_result_free(&r);
+    cbm_store_close(s);
+    PASS();
+}
+
+TEST(cypher_exec_where_prop_neq) {
+    cbm_store_t *s = setup_cypher_store();
+    /* Add a self-call on HandleOrder to verify `a.name <> b.name` filters it out */
+    cbm_node_t n1 = {.project = "test",
+                     .label = "Function",
+                     .name = "HandleOrder",
+                     .qualified_name = "test.HandleOrder",
+                     .file_path = "handler.go",
+                     .start_line = 10,
+                     .end_line = 30};
+    int64_t id1 = cbm_store_upsert_node(s, &n1);
+    cbm_edge_t self_edge = {
+        .project = "test", .source_id = id1, .target_id = id1, .type = "CALLS"};
+    cbm_store_insert_edge(s, &self_edge);
+
+    cbm_cypher_result_t r = {0};
+    int rc = cbm_cypher_execute(
+        s, "MATCH (a:Function)-[:CALLS]->(b:Function) WHERE a.name <> b.name RETURN a.name, b.name",
+        "test", 0, &r);
+    ASSERT_EQ(rc, 0);
+    /* 3 non-self CALLS edges remain; the self-call HandleOrder->HandleOrder is excluded */
+    ASSERT_EQ(r.row_count, 3);
+    cbm_cypher_result_free(&r);
+    cbm_store_close(s);
+    PASS();
+}
+
+TEST(cypher_exec_where_prop_ordering) {
+    /* setup_cypher_store:
+     * HandleOrder (start_line=10) -> ValidateOrder (start_line=5)
+     * HandleOrder (start_line=10) -> LogError (start_line=0)
+     * ValidateOrder (start_line=5) -> SubmitOrder (start_line=0) */
+    cbm_store_t *s = setup_cypher_store();
+    cbm_cypher_result_t r = {0};
+    int rc = cbm_cypher_execute(
+        s,
+        "MATCH (a:Function)-[:CALLS]->(b:Function) "
+        "WHERE a.start_line > b.start_line AND b.start_line > 0 "
+        "RETURN a.name, b.name",
+        "test", 0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r.row_count, 1);
+    ASSERT_STR_EQ(r.rows[0][0], "HandleOrder");
+    ASSERT_STR_EQ(r.rows[0][1], "ValidateOrder");
+    cbm_cypher_result_free(&r);
+    cbm_store_close(s);
+    PASS();
+}
+
