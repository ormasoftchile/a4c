         }
@@ -2327,23 +2345,29 @@ static void binding_set(binding_t *b, const char *var, const cbm_node_t *node) {
     b->var_count++;
 }
 
-/* Resolve the actual property value for a condition from a binding */
-static const char *resolve_condition_value(const cbm_condition_t *c, binding_t *b) {
-    cbm_edge_t *e = binding_get_edge(b, c->variable);
+/* Resolve a (variable, property) pair from a binding to a string value */
+static const char *resolve_binding_value(const char *variable, const char *property,
+                                         binding_t *b) {
+    cbm_edge_t *e = binding_get_edge(b, variable);
     if (e) {
-        return edge_prop(e, c->property);
+        return edge_prop(e, property);
     }
-    cbm_node_t *n = binding_get(b, c->variable);
+    cbm_node_t *n = binding_get(b, variable);
     if (!n) {
         return NULL; /* unbound variable */
     }
-    if (c->property) {
-        return node_prop(n, c->property, b->store);
+    if (property) {
+        return node_prop(n, property, b->store);
     }
     /* Bare alias (e.g. post-WITH virtual var) — use node name directly */
     return n->name ? n->name : "";
 }
 
+/* Resolve the actual property value for a condition from a binding */
+static const char *resolve_condition_value(const cbm_condition_t *c, binding_t *b) {
+    return resolve_binding_value(c->variable, c->property, b);
+}
+
 /* Evaluate a comparison operator between actual and expected strings. */
 static bool eval_comparison_op(const char *op, const char *actual, const char *expected) {
     if (strcmp(op, "=") == 0) {
@@ -2461,7 +2485,15 @@ static bool eval_condition(const cbm_condition_t *c, binding_t *b) {
         return c->negated ? !result : result;
     }
 
-    result = eval_comparison_op(c->op, actual, c->value);
+    const char *expected = c->value;
+    if (c->value_variable) {
+        expected = resolve_binding_value(c->value_variable, c->value_property, b);
+        if (!expected) {
+            return true; /* unbound RHS variable — same as unbound LHS */
+        }
+    }
+
+    result = eval_comparison_op(c->op, actual, expected);
     return c->negated ? !result : result;
 }
 
