+    if (c->rhs_variable) {
+        const char *rhs_value = resolve_var_prop(c->rhs_variable, c->rhs_property, b);
+        if (!rhs_value) {
+            return true;
+        }
+        result = eval_comparison_op(c->op, actual, rhs_value);
+        return c->negated ? !result : result;
+    }
+
     result = eval_comparison_op(c->op, actual, c->value);
     return c->negated ? !result : result;
 }
