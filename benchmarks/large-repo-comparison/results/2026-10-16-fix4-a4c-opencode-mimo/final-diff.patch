+/* Resolve the value of a (variable, property) pair from a binding. A NULL
+ * property means bare alias (post-WITH virtual var) — use the node name. */
+static const char *resolve_var_prop(const char *variable, const char *property, binding_t *b) {
+    cbm_edge_t *e = binding_get_edge(b, variable);
     if (e) {
-        return edge_prop(e, c->property);
