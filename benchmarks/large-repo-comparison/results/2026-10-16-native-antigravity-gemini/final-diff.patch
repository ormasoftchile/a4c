+/* Check whether an expression tree references any variable not yet bound in b. */
+static bool expr_has_unbound(const cbm_expr_t *e, binding_t *b) { // NOLINT(misc-no-recursion)
+    if (!e) {
+        return false;
+    }
+    switch (e->type) {
+    case EXPR_CONDITION:
+        if (!resolve_condition_value(&e->cond, b)) {
+            return true;
+        }
+        if (e->cond.rhs_variable &&
+            !resolve_var_prop(b, e->cond.rhs_variable, e->cond.rhs_property)) {
+            return true;
+        }
+        return false;
+    case EXPR_AND:
+    case EXPR_OR:
+    case EXPR_XOR:
+        return expr_has_unbound(e->left, b) || expr_has_unbound(e->right, b);
+    case EXPR_NOT:
+        return expr_has_unbound(e->left, b);
+    }
+    return false;
+}
