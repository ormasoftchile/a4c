diff --git a/tests/test_cypher.c b/tests/test_cypher.c
index 2e79c8b..d2089f9 100644
--- a/tests/test_cypher.c
+++ b/tests/test_cypher.c
@@ -2521,6 +2521,162 @@ TEST(cypher_multi_prop_projection_no_alias) {
     PASS();
 }
 
+/* ── Property-to-property WHERE comparisons ───────────────────── */
+
+TEST(cypher_parse_where_prop_to_prop) {
+    cbm_query_t *q = NULL;
+    char *err = NULL;
+    int rc = cbm_cypher_parse(
+        "MATCH (a)-[:CALLS]->(b) WHERE a.file_path = b.file_path RETURN a.name, b.name", &q, &err);
+    ASSERT_EQ(rc, 0);
+    ASSERT_NULL(err);
+    ASSERT_NOT_NULL(q);
+    ASSERT_NOT_NULL(q->where);
+    ASSERT_NOT_NULL(q->where->root);
+    ASSERT_EQ(q->where->root->type, EXPR_CONDITION);
+    ASSERT_STR_EQ(q->where->root->cond.variable, "a");
+    ASSERT_STR_EQ(q->where->root->cond.property, "file_path");
+    ASSERT_STR_EQ(q->where->root->cond.op, "=");
+    ASSERT_NULL(q->where->root->cond.value);
+    ASSERT_STR_EQ(q->where->root->cond.rhs_variable, "b");
+    ASSERT_STR_EQ(q->where->root->cond.rhs_property, "file_path");
+    cbm_query_free(q);
+
+    /* Unsupported RHS function call must still fail cleanly */
+    rc = cbm_cypher_parse("MATCH (a)-[:CALLS]->(b) WHERE a.name = nosuch(b.name) RETURN a.name", &q,
+                          &err);
+    ASSERT_EQ(rc, -1);
+    ASSERT_NOT_NULL(err);
+    free(err);
+    PASS();
+}
+
+static cbm_store_t *setup_prop_cmp_store(void) {
+    cbm_store_t *s = cbm_store_open_memory();
+    cbm_store_upsert_project(s, "test", "/tmp/test");
+
+    cbm_node_t n1 = {.project = "test",
+                     .label = "Function",
+                     .name = "Caller",
+                     .qualified_name = "test.Caller",
+                     .file_path = "same.go",
+                     .start_line = 10,
+                     .end_line = 25};
+    cbm_node_t n2 = {.project = "test",
+                     .label = "Function",
+                     .name = "LocalHelper",
+                     .qualified_name = "test.LocalHelper",
+                     .file_path = "same.go",
+                     .start_line = 30,
+                     .end_line = 45};
+    cbm_node_t n3 = {.project = "test",
+                     .label = "Function",
+                     .name = "RemoteHelper",
+                     .qualified_name = "test.RemoteHelper",
+                     .file_path = "other.go",
+                     .start_line = 5,
+                     .end_line = 15};
+
+    int64_t id1 = cbm_store_upsert_node(s, &n1);
+    int64_t id2 = cbm_store_upsert_node(s, &n2);
+    int64_t id3 = cbm_store_upsert_node(s, &n3);
+
+    /* Caller -> LocalHelper (same file, start_line 10 < 30) */
+    cbm_edge_t e1 = {.project = "test", .source_id = id1, .target_id = id2, .type = "CALLS"};
+    /* Caller -> RemoteHelper (different file, start_line 10 > 5) */
+    cbm_edge_t e2 = {.project = "test", .source_id = id1, .target_id = id3, .type = "CALLS"};
+    /* Caller -> Caller (self-call, same name & file) */
+    cbm_edge_t e3 = {.project = "test", .source_id = id1, .target_id = id1, .type = "CALLS"};
+
+    cbm_store_insert_edge(s, &e1);
+    cbm_store_insert_edge(s, &e2);
+    cbm_store_insert_edge(s, &e3);
+    return s;
+}
+
+TEST(cypher_exec_where_prop_eq_prop) {
+    cbm_store_t *s = setup_prop_cmp_store();
+    cbm_cypher_result_t r = {0};
+    int rc = cbm_cypher_execute(
+        s, "MATCH (a)-[:CALLS]->(b) WHERE a.file_path = b.file_path RETURN a.name, b.name", "test",
+        0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_NULL(r.error);
+    /* Caller->LocalHelper and Caller->Caller share "same.go"; Caller->RemoteHelper does not */
+    ASSERT_EQ(r.row_count, 2);
+    ASSERT_TRUE(cypher_has_row_with(&r, "b.name", "LocalHelper"));
+    ASSERT_TRUE(cypher_has_row_with(&r, "b.name", "Caller"));
+    ASSERT_FALSE(cypher_has_row_with(&r, "b.name", "RemoteHelper"));
+    cbm_cypher_result_free(&r);
+    cbm_store_close(s);
+    PASS();
+}
+
+TEST(cypher_exec_where_prop_neq_prop) {
+    cbm_store_t *s = setup_prop_cmp_store();
+    cbm_cypher_result_t r = {0};
+    int rc = cbm_cypher_execute(
+        s, "MATCH (a)-[:CALLS]->(b) WHERE a.name <> b.name RETURN a.name, b.name", "test", 0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_NULL(r.error);
+    /* Excludes self-call Caller->Caller; keeps LocalHelper and RemoteHelper */
+    ASSERT_EQ(r.row_count, 2);
+    ASSERT_TRUE(cypher_has_row_with(&r, "b.name", "LocalHelper"));
+    ASSERT_TRUE(cypher_has_row_with(&r, "b.name", "RemoteHelper"));
+    ASSERT_FALSE(cypher_has_row_with(&r, "b.name", "Caller"));
+    cbm_cypher_result_free(&r);
+    cbm_store_close(s);
+    PASS();
+}
+
+TEST(cypher_exec_where_prop_ordering) {
+    cbm_store_t *s = setup_prop_cmp_store();
+    cbm_cypher_result_t r = {0};
+    /* Caller (start_line=10) < LocalHelper (start_line=30) is the only strictly increasing edge */
+    int rc = cbm_cypher_execute(
+        s, "MATCH (a)-[:CALLS]->(b) WHERE a.start_line < b.start_line RETURN a.name, b.name",
+        "test", 0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_NULL(r.error);
+    ASSERT_EQ(r.row_count, 1);
+    ASSERT_STR_EQ(r.rows[0][0], "Caller");
+    ASSERT_STR_EQ(r.rows[0][1], "LocalHelper");
+    cbm_cypher_result_free(&r);
+
+    /* Caller (start_line=10) > RemoteHelper (start_line=5) */
+    cbm_cypher_result_t r2 = {0};
+    rc = cbm_cypher_execute(
+        s, "MATCH (a)-[:CALLS]->(b) WHERE a.start_line > b.start_line RETURN a.name, b.name",
+        "test", 0, &r2);
+    ASSERT_EQ(rc, 0);
+    ASSERT_NULL(r2.error);
+    ASSERT_EQ(r2.row_count, 1);
+    ASSERT_STR_EQ(r2.rows[0][0], "Caller");
+    ASSERT_STR_EQ(r2.rows[0][1], "RemoteHelper");
+    cbm_cypher_result_free(&r2);
+
+    cbm_store_close(s);
+    PASS();
+}
+
+TEST(cypher_exec_with_where_prop_to_prop) {
+    cbm_store_t *s = setup_prop_cmp_store();
+    cbm_cypher_result_t r = {0};
+    int rc = cbm_cypher_execute(
+        s,
+        "MATCH (a)-[:CALLS]->(b) WITH a, b WHERE a.file_path = b.file_path RETURN a.name, b.name",
+        "test", 0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_NULL(r.error);
+    ASSERT_EQ(r.row_count, 2);
+    ASSERT_TRUE(cypher_has_row_with(&r, "b.name", "LocalHelper"));
+    ASSERT_TRUE(cypher_has_row_with(&r, "b.name", "Caller"));
+    ASSERT_FALSE(cypher_has_row_with(&r, "b.name", "RemoteHelper"));
+    cbm_cypher_result_free(&r);
+    cbm_store_close(s);
+    PASS();
+}
+
