diff --git a/tests/test_cypher.c b/tests/test_cypher.c
index 2e79c8b..837d3a1 100644
--- a/tests/test_cypher.c
+++ b/tests/test_cypher.c
@@ -1695,6 +1695,156 @@ TEST(cypher_exec_where_is_not_null) {
     PASS();
 }
 
+/* Helper: two functions in the same file calling each other — for
+ * property-to-property WHERE comparisons (a.file_path = b.file_path). */
+static cbm_store_t *setup_cypher_shared_file_store(void) {
+    cbm_store_t *s = cbm_store_open_memory();
+    cbm_store_upsert_project(s, "test", "/tmp/test");
+    cbm_node_t n1 = {.project = "test",
+                     .label = "Function",
+                     .name = "Alpha",
+                     .qualified_name = "test.Alpha",
+                     .file_path = "demo.go",
+                     .start_line = 20};
+    cbm_node_t n2 = {.project = "test",
+                     .label = "Function",
+                     .name = "Beta",
+                     .qualified_name = "test.Beta",
+                     .file_path = "demo.go",
+                     .start_line = 5};
+    int64_t id1 = cbm_store_upsert_node(s, &n1);
+    int64_t id2 = cbm_store_upsert_node(s, &n2);
+    cbm_edge_t e = {.project = "test", .source_id = id1, .target_id = id2, .type = "CALLS"};
+    cbm_store_insert_edge(s, &e);
+    return s;
+}
+
+TEST(cypher_exec_where_prop_eq_prop) {
+    cbm_store_t *s = setup_cypher_shared_file_store();
+    cbm_cypher_result_t r = {0};
+
+    /* Alpha and Beta share file_path → match */
+    int rc = cbm_cypher_execute(
+        s, "MATCH (a)-[:CALLS]->(b) WHERE a.file_path = b.file_path RETURN a.name, b.name",
+        "test", 0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r.row_count, 1);
+    ASSERT_STR_EQ(cypher_get_col(&r, 0, "a.name"), "Alpha");
+    ASSERT_STR_EQ(cypher_get_col(&r, 0, "b.name"), "Beta");
+    cbm_cypher_result_free(&r);
+
+    /* Same edge, different property values → no match */
+    cbm_cypher_result_t r2 = {0};
+    rc = cbm_cypher_execute(s, "MATCH (a)-[:CALLS]->(b) WHERE a.name = b.name RETURN a.name",
+                            "test", 0, &r2);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r2.row_count, 0);
+    cbm_cypher_result_free(&r2);
+
+    cbm_store_close(s);
+    PASS();
+}
+
+TEST(cypher_exec_where_prop_neq_prop) {
+    cbm_store_t *s = setup_cypher_store();
+    cbm_cypher_result_t r = {0};
+
+    /* Every CALLS edge in the standard graph connects different files */
+    int rc = cbm_cypher_execute(
+        s, "MATCH (a)-[:CALLS]->(b) WHERE a.file_path <> b.file_path RETURN a.name, b.name",
+        "test", 0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r.row_count, 3);
+    cbm_cypher_result_free(&r);
+    cbm_store_close(s);
+    PASS();
+}
+
+TEST(cypher_exec_where_prop_gt_prop) {
+    cbm_store_t *s = setup_cypher_shared_file_store();
+    cbm_cypher_result_t r = {0};
+
+    /* Alpha(start_line=20) → Beta(start_line=5) */
+    int rc = cbm_cypher_execute(
+        s, "MATCH (a)-[:CALLS]->(b) WHERE a.start_line > b.start_line RETURN a.name",
+        "test", 0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r.row_count, 1);
+    ASSERT_STR_EQ(cypher_get_col(&r, 0, "a.name"), "Alpha");
+    cbm_cypher_result_free(&r);
+
+    cbm_cypher_result_t r2 = {0};
+    rc = cbm_cypher_execute(s, "MATCH (a)-[:CALLS]->(b) WHERE a.start_line < b.start_line "
+                               "RETURN a.name",
+                            "test", 0, &r2);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r2.row_count, 0);
+    cbm_cypher_result_free(&r2);
+    cbm_store_close(s);
+    PASS();
+}
+
+TEST(cypher_parse_where_prop_eq_prop) {
+    cbm_query_t *q = NULL;
+    char *err = NULL;
+    int rc = cbm_cypher_parse("MATCH (a)-[:CALLS]->(b) WHERE a.file_path = b.file_path RETURN a",
+                              &q, &err);
+    ASSERT_EQ(rc, 0);
+    ASSERT_NOT_NULL(q->where->root);
+    ASSERT_EQ(q->where->root->type, EXPR_CONDITION);
+    ASSERT_STR_EQ(q->where->root->cond.variable, "a");
+    ASSERT_STR_EQ(q->where->root->cond.property, "file_path");
+    ASSERT_STR_EQ(q->where->root->cond.op, "=");
+    ASSERT_NULL(q->where->root->cond.value);
+    ASSERT_STR_EQ(q->where->root->cond.rhs_variable, "b");
+    ASSERT_STR_EQ(q->where->root->cond.rhs_property, "file_path");
+    cbm_query_free(q);
+    PASS();
+}
+
+TEST(cypher_parse_where_prop_rhs_error) {
+    cbm_query_t *q = NULL;
+    char *err = NULL;
+    int rc = cbm_cypher_parse("MATCH (a)-[:CALLS]->(b) WHERE a.name = toString(b.name) RETURN a",
+                              &q, &err);
+    ASSERT_EQ(rc, -1);
+    ASSERT_NOT_NULL(err);
+    free(err);
+    PASS();
+}
+
+TEST(cypher_exec_with_where_prop_eq_prop) {
+    cbm_store_t *s = setup_cypher_shared_file_store();
+    cbm_cypher_result_t r = {0};
+    int rc = cbm_cypher_execute(s,
+                                "MATCH (a)-[:CALLS]->(b) "
+                                "WITH a, b WHERE a.file_path = b.file_path "
+                                "RETURN a.name, b.name",
+                                "test", 0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r.row_count, 1);
+    ASSERT_STR_EQ(cypher_get_col(&r, 0, "a.name"), "Alpha");
+    ASSERT_STR_EQ(cypher_get_col(&r, 0, "b.name"), "Beta");
+    cbm_cypher_result_free(&r);
+    cbm_store_close(s);
+    PASS();
+}
+
+TEST(cypher_exec_where_prop_eq_literal_regression) {
+    cbm_store_t *s = setup_cypher_shared_file_store();
+    cbm_cypher_result_t r = {0};
+    int rc = cbm_cypher_execute(s,
+                                "MATCH (a)-[:CALLS]->(b) WHERE b.file_path = 'demo.go' "
+                                "RETURN a.name, b.name",
+                                "test", 0, &r);
+    ASSERT_EQ(rc, 0);
+    ASSERT_EQ(r.row_count, 1);
+    ASSERT_STR_EQ(cypher_get_col(&r, 0, "b.name"), "Beta");
+    cbm_cypher_result_free(&r);
+    cbm_store_close(s);
+    PASS();
+}
+
