+		{name: "overlaps counted once", ivs: []Interval{{0, 10}, {5, 20}, {30, 40}}, want: 30},
+		{name: "touching merged", ivs: []Interval{{0, 10}, {10, 20}}, want: 20},
+		{name: "containment", ivs: []Interval{{0, 100}, {20, 30}}, want: 100},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if got := Total(c.ivs); got != c.want {
+				t.Fatalf("Total(%v) = %d, want %d", c.ivs, got, c.want)
+			}
+		})
+	}
+}
