+
+func TestMerge(t *testing.T) {
+	cases := []struct {
+		name string
+		ivs  []Interval
+		want []Interval
+	}{
+		{
+			name: "empty",
+			ivs:  nil,
+			want: nil,
+		},
+		{
+			name: "all invalid",
+			ivs:  []Interval{{10, 10}, {-1, 5}, {0, 1441}},
+			want: nil,
+		},
+		{
+			name: "sorts and merges overlapping intervals",
+			ivs:  []Interval{{30, 40}, {0, 10}, {5, 20}},
+			want: []Interval{{0, 20}, {30, 40}},
+		},
+		{
+			name: "merges touching intervals",
+			ivs:  []Interval{{10, 20}, {0, 10}, {20, 30}},
+			want: []Interval{{0, 30}},
+		},
+		{
+			name: "keeps non-overlapping gaps",
+			ivs:  []Interval{{0, 10}, {20, 30}},
+			want: []Interval{{0, 10}, {20, 30}},
+		},
+		{
+			name: "containment",
+			ivs:  []Interval{{0, 100}, {20, 30}, {40, 50}},
+			want: []Interval{{0, 100}},
+		},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if got := Merge(c.ivs); !reflect.DeepEqual(got, c.want) {
+				t.Fatalf("Merge(%v) = %v, want %v", c.ivs, got, c.want)
+			}
+		})
+	}
+}
+
