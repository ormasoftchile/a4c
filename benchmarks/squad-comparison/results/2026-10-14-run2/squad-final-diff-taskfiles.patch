+
+// Merge returns the canonical union of valid intervals, sorted by From.
+// Overlapping or touching intervals are combined.
+func Merge(ivs []Interval) []Interval {
+	valid := make([]Interval, 0, len(ivs))
+	for _, iv := range ivs {
+		if iv.IsValid() {
+			valid = append(valid, iv)
+		}
+	}
+	if len(valid) == 0 {
+		return nil
+	}
+
+	sorted := SortIntervals(valid)
+	out := make([]Interval, 0, len(sorted))
+	for _, iv := range sorted {
+		if len(out) == 0 {
+			out = append(out, iv)
+			continue
+		}
+		last := &out[len(out)-1]
+		if iv.From <= last.To {
+			if iv.To > last.To {
+				last.To = iv.To
+			}
+			continue
+		}
+		out = append(out, iv)
+	}
+	return out
+}
+
+// Total returns the number of minutes covered by the union of valid intervals.
+func Total(ivs []Interval) int {
+	total := 0
+	for _, iv := range Merge(ivs) {
+		total += iv.To - iv.From
+	}
+	return total
+}
+
+// Subtract returns the parts of base not covered by valid overlapping others.
+func Subtract(base Interval, others []Interval) []Interval {
+	if !base.IsValid() {
+		return nil
+	}
+
+	clipped := make([]Interval, 0, len(others))
+	for _, other := range others {
+		if !other.IsValid() || !base.Overlaps(other) {
+			continue
+		}
+		if other.From < base.From {
+			other.From = base.From
+		}
+		if other.To > base.To {
+			other.To = base.To
+		}
+		clipped = append(clipped, other)
+	}
+
+	covered := Merge(clipped)
+	if len(covered) == 0 {
+		return []Interval{base}
+	}
+
+	out := make([]Interval, 0, len(covered)+1)
+	cursor := base.From
+	for _, iv := range covered {
+		if cursor < iv.From {
+			out = append(out, Interval{cursor, iv.From})
+		}
+		if iv.To > cursor {
+			cursor = iv.To
+		}
+	}
+	if cursor < base.To {
+		out = append(out, Interval{cursor, base.To})
+	}
+	if len(out) == 0 {
+		return nil
+	}
+	return out
+}
+
+// Complement returns the gaps within universe not covered by valid intervals.
+func Complement(ivs []Interval, universe Interval) []Interval {
+	if !universe.IsValid() {
+		return nil
+	}
+	return Subtract(universe, ivs)
+}
