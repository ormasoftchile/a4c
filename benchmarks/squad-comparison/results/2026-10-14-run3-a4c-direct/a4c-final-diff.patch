+			name:   "empty others returns base",
+			base:   Interval{10, 20},
+			others: nil,
+			want:   []Interval{{10, 20}},
+		},
+		{
+			name:   "ignores invalid and non-overlapping",
+			base:   Interval{10, 30},
+			others: []Interval{{0, 10}, {30, 40}, {12, 12}, {-1, 20}},
+			want:   []Interval{{10, 30}},
+		},
+		{
+			name:   "splits around covered middle",
+			base:   Interval{0, 100},
+			others: []Interval{{20, 30}, {40, 50}},
+			want:   []Interval{{0, 20}, {30, 40}, {50, 100}},
+		},
+		{
+			name:   "touching coverage merges",
+			base:   Interval{0, 100},
+			others: []Interval{{20, 30}, {30, 40}},
+			want:   []Interval{{0, 20}, {40, 100}},
+		},
+		{
+			name:   "coverage clipped to base",
+			base:   Interval{20, 80},
+			others: []Interval{{0, 30}, {70, 100}},
+			want:   []Interval{{30, 70}},
+		},
+		{
+			name:   "full coverage",
+			base:   Interval{20, 80},
+			others: []Interval{{0, 30}, {30, 70}, {70, 100}},
+			want:   []Interval{},
+		},
+		{
+			name:   "contained by covering interval",
+			base:   Interval{20, 80},
+			others: []Interval{{10, 100}},
+			want:   []Interval{},
+		},
+	}
+
+	for _, c := range cases {
