+// Merge returns valid intervals in canonical form: sorted and coalesced.
+func Merge(ivs []Interval) []Interval {
+	valid := make([]Interval, 0, len(ivs))
+	for _, iv := range ivs {
+		if iv.IsValid() {
+			valid = append(valid, iv)
+		}
+	}
+	if len(valid) == 0 {
+		return []Interval{}
+	}
+
+	sorted := SortIntervals(valid)
+	out := make([]Interval, 0, len(sorted))
+	for _, iv := range sorted {
+		last := len(out) - 1
+		if len(out) == 0 || out[last].To < iv.From {
+			out = append(out, iv)
+			continue
+		}
+		if iv.To > out[last].To {
+			out[last].To = iv.To
+		}
+	}
+	return out
+}
+
+// Total returns the number of minutes covered by the union of ivs.
+func Total(ivs []Interval) int {
+	total := 0
+	for _, iv := range Merge(ivs) {
+		total += iv.To - iv.From
+	}
+	return total
+}
+
+// Subtract returns the parts of base not covered by any interval in others.
+func Subtract(base Interval, others []Interval) []Interval {
+	if !base.IsValid() {
+		return []Interval{}
+	}
+
+	covered := make([]Interval, 0, len(others))
+	for _, iv := range others {
+		if !iv.IsValid() || !iv.Overlaps(base) {
+			continue
+		}
+		if iv.From < base.From {
+			iv.From = base.From
+		}
+		if iv.To > base.To {
+			iv.To = base.To
+		}
+		covered = append(covered, iv)
+	}
+
+	cursor := base.From
+	out := []Interval{}
+	for _, iv := range Merge(covered) {
+		if cursor < iv.From {
+			out = append(out, Interval{cursor, iv.From})
+		}
+		if iv.To > cursor {
+			cursor = iv.To
+		}
+	}
+	if cursor < base.To {
+		out = append(out, Interval{cursor, base.To})
+	}
+	return out
+}
+
+// Complement returns the gaps within universe not covered by ivs.
+func Complement(ivs []Interval, universe Interval) []Interval {
+	return Subtract(universe, ivs)
+}
