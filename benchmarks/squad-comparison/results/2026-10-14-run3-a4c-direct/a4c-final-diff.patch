+func TestMerge(t *testing.T) {
+	cases := []struct {
+		name string
+		ivs  []Interval
+		want []Interval
+	}{
+		{
+			name: "empty",
+			ivs:  nil,
+			want: []Interval{},
+		},
+		{
+			name: "ignores invalid",
+			ivs:  []Interval{{10, 10}, {-1, 5}, {20, 30}},
+			want: []Interval{{20, 30}},
+		},
+		{
+			name: "all invalid",
+			ivs:  []Interval{{10, 10}, {30, 20}},
+			want: []Interval{},
+		},
+		{
+			name: "overlap and touching",
+			ivs:  []Interval{{30, 40}, {0, 10}, {5, 20}, {20, 30}},
+			want: []Interval{{0, 40}},
+		},
+		{
+			name: "containment keeps outer bounds",
+			ivs:  []Interval{{10, 100}, {20, 30}, {40, 50}, {120, 130}},
+			want: []Interval{{10, 100}, {120, 130}},
+		},
+	}
+
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if got := Merge(c.ivs); !reflect.DeepEqual(got, c.want) {
+				t.Fatalf("Merge(%v) = %v, want %v", c.ivs, got, c.want)
+			}
+		})
+	}
+}
