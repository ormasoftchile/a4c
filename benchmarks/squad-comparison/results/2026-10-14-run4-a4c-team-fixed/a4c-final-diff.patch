+// Merge returns sorted valid intervals with overlapping or touching ranges combined.
+func Merge(ivs []Interval) []Interval {
+	valid := make([]Interval, 0, len(ivs))
+	for _, iv := range ivs {
+		if iv.IsValid() {
+			valid = append(valid, iv)
+		}
+	}
+	if len(valid) == 0 {
+		return []Interval{}
+	}
+
+	sorted := SortIntervals(valid)
+	merged := make([]Interval, 0, len(sorted))
+	cur := sorted[0]
+	for _, next := range sorted[1:] {
+		if cur.To >= next.From {
+			if next.To > cur.To {
+				cur.To = next.To
+			}
+			continue
+		}
+		merged = append(merged, cur)
+		cur = next
+	}
+	merged = append(merged, cur)
+	return merged
+}
+
+// Total returns the total duration in minutes covered by valid intervals.
+func Total(ivs []Interval) int {
+	total := 0
+	for _, iv := range Merge(ivs) {
+		total += iv.To - iv.From
+	}
+	return total
+}
+
+// Subtract returns the valid parts of base not covered by any valid interval in others.
+func Subtract(base Interval, others []Interval) []Interval {
+	if !base.IsValid() {
+		return []Interval{}
+	}
+
+	clipped := make([]Interval, 0, len(others))
+	for _, other := range others {
+		if !other.IsValid() || !base.Overlaps(other) {
+			continue
+		}
+		from := other.From
+		if from < base.From {
+			from = base.From
+		}
+		to := other.To
+		if to > base.To {
+			to = base.To
+		}
+		if from < to {
+			clipped = append(clipped, Interval{From: from, To: to})
+		}
+	}
+
+	covered := Merge(clipped)
+	gaps := make([]Interval, 0, len(covered)+1)
+	cursor := base.From
+	for _, cover := range covered {
+		if cursor < cover.From {
+			gaps = append(gaps, Interval{From: cursor, To: cover.From})
+		}
+		if cursor < cover.To {
+			cursor = cover.To
+		}
+		if cursor >= base.To {
+			return gaps
+		}
+	}
+	if cursor < base.To {
+		gaps = append(gaps, Interval{From: cursor, To: base.To})
+	}
+	return gaps
+}
+
+// Complement returns the sorted gaps inside universe not covered by valid intervals.
+func Complement(ivs []Interval, universe Interval) []Interval {
+	return Subtract(universe, ivs)
+}
